# Configurações da API
API_BASE_URL=https://api.vehicleconsult.com
API_TIMEOUT=30000

# APIs de Consulta Veicular (Gratuitas)
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1
DENATRAN_API_URL=https://api.denatran.gov.br
VEHICLE_API_KEY=your_vehicle_api_key_here

# Firebase (opcional)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=vehicleconsult.firebaseapp.com
FIREBASE_PROJECT_ID=vehicleconsult
FIREBASE_STORAGE_BUCKET=vehicleconsult.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abc123def456

# Google Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Facebook
FACEBOOK_APP_ID=your_facebook_app_id

# Sentry (Monitoramento de Erros)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Ambiente
NODE_ENV=development
DEBUG_MODE=true

# Configurações de Billing
GOOGLE_PLAY_LICENSE_KEY=your_google_play_license_key

# URLs do Backend
AUTH_ENDPOINT=/auth
VEHICLES_ENDPOINT=/vehicles
USERS_ENDPOINT=/users
BILLING_ENDPOINT=/billing
SUPPORT_ENDPOINT=/support

# Configurações de Cache
CACHE_DURATION=3600
OFFLINE_MODE=false

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token

# Configurações de Push Notification
FCM_SERVER_KEY=your_fcm_server_key
PUSH_NOTIFICATION_ENABLED=true

# Configurações de Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_DAY=1000

# Configurações de Segurança
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key
SALT_ROUNDS=12

# URLs de Suporte
SUPPORT_EMAIL=suporte@vehicleconsult.com
SUPPORT_PHONE=+5511999999999
SUPPORT_WHATSAPP=5511999999999
WEBSITE_URL=https://vehicleconsult.com
PRIVACY_POLICY_URL=https://vehicleconsult.com/privacidade
TERMS_URL=https://vehicleconsult.com/termos